# PONS V2 TOKEN CONFIGURATION (Robinhood Chain ID: 4663)
VITE_TOKEN_NAME="BLAZE"
VITE_TOKEN_SYMBOL="BLAZE"
VITE_TOKEN_ADDRESS="0xc5547b341002dcdad191512d5f6f52a928e41bf4"

# 1. KONTRAK BONDING CURVE (Swap sebelum token bermigrasi / ungraduated)
# Kosongkan jika ingin auto-detect dari token via token.curve()
VITE_CURVE_ADDRESS=""

# 2. KONTRAK UNISWAP (Swap sesudah token bermigrasi / graduated)
# Default router resmi Robinhood Chain: Uniswap v4 Universal Router
VITE_UNISWAP_ROUTER_ADDRESS="0x8876789976dEcBfCbBbe364623C63652db8C0904"

# CREATOR & SIKLUS ENGINE
VITE_CREATOR_ADDRESS=""
VITE_CLAIM_THRESHOLD_ETH="0.01"
VITE_CYCLE_INTERVAL_SECONDS="300"
VITE_RPC_URL="https://rpc.mainnet.chain.robinhood.com"

# WALLET OPERATOR BOT (Untuk eksekusi background 24/7 di VPS/PC)
CREATOR_PRIVATE_KEY=""
PORT=5015
WEB_PORT=3095

# SECURITY
# Secret for the /memex admin panel (min 16 characters). Every change to the token,
# treasury or operator key must send it. Leave empty to keep the admin API closed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=""
# The bot API listens on this host. Keep 127.0.0.1: the web server reaches it through /api.
BOT_HOST="127.0.0.1"
# The dev server (npm run dev) can write .env, so it only listens on this machine.
# Set WEB_HOST="0.0.0.0" only on a trusted network.
WEB_HOST="127.0.0.1"
